generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         String   @id
  userId     String
  categoryId String
  name       String
  amount     String
  currency   String
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id])
  Category   Category @relation(fields: [categoryId], references: [id])
}

model Income {
  id           String   @id
  userId       String
  date         DateTime
  currency     String
  recurrence   String
  categoryId   String
  categoryName String
  name         String
  description  String
  amount       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id])
  Category     Category @relation(fields: [categoryId], references: [id])
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String         @id
  email              String         @unique
  name               String
  password           String
  theme              String
  currency           String
  conversionCurrency String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  RefreshToken       RefreshToken[]
  Expense            Expense[]
  Income             Income[]
}

model Category {
  id        String    @id
  name      String
  iconName  String
  color     String
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Expense   Expense[]
  isIncome  Boolean   @default(false)
  Income    Income[]
}
