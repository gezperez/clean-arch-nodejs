generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  EXPENSE
  INCOME
}

model Movement {
  id           String       @id
  userId       String
  currency     String
  recurrence   String
  name         String
  description  String
  amount       String
  type         MovementType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  user         User         @relation(fields: [userId], references: [id])
  category     Category     @relation(fields: [categoryId], references: [id])
  categoryId   String

  @@index([userId])
  @@index([categoryId])
}

model RefreshToken {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String         @id
  email              String         @unique
  name               String
  password           String
  theme              String
  currency           String
  conversionCurrency String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  RefreshToken       RefreshToken[]
  movements          Movement[]
}

model Category {
  id        String       @id
  name      String
  iconName  String
  color     String
  createdAt DateTime     @default(now())
  updatedAt DateTime
  movements Movement[]
  type      MovementType @default(EXPENSE)
}
